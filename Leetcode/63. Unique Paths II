class Solution {
    public int uniquePathsWithObstacles(int[][] obstacleGrid) {
        int m = obstacleGrid.length;
        int n = obstacleGrid[0].length;

        // If start is blocked
        if (obstacleGrid[0][0] == 1)
            return 0;

        int[][] dp = new int[m][n];

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {

                // Skip the starting cell
                if (i == 0 && j == 0){
                    dp[i][j]=1;
                    continue;
                }

                // Obstacle
                if (obstacleGrid[i][j] == 1) {
                    dp[i][j] = 0;
                }
                // First row
                else if (i == 0) {
                    dp[i][j] = dp[i][j - 1];
                }
                // First column
                else if (j == 0) {
                    dp[i][j] = dp[i - 1][j];
                }
                // General case
                else {
                    dp[i][j] = dp[i - 1][j] + dp[i][j - 1];
                }
            }
        }

        return dp[m - 1][n - 1];
    }
}
